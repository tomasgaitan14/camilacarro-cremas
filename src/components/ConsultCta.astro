---
import ConsultButton from './ConsultButton.astro';

interface Props {
  title?: string;
  text?: string;
  label?: string;
}

const {
  title = 'Te ayudamos a elegir',
  text = 'Elegir productos para tu piel no tiene por qué ser complicado. Si tenés dudas sobre cómo usar un producto o cómo incorporarlo a tu rutina, podemos ayudarte a encontrar la información que necesitás.',
  label = 'Consultar por WhatsApp',
} = Astro.props;
---

<section class="reveal rounded-[2.5rem] bg-blush/80 p-8 sm:p-12 lg:p-14" aria-labelledby="consulta">
  <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr] lg:gap-14">
    <div>
      <h2 id="consulta" class="text-3xl font-medium tracking-tighter sm:text-4xl">{title}</h2>
      <p class="mt-4 max-w-[56ch] text-muted">{text}</p>
    </div>
    <div class="lg:justify-self-end">
      <ConsultButton label={label}>
        <p slot="fallback" class="text-sm text-muted">La consulta por WhatsApp estará disponible muy pronto.</p>
      </ConsultButton>
    </div>
  </div>
</section>

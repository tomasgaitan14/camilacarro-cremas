---
import { getCollection } from 'astro:content';
import type { ComponentProps } from 'astro/types';
import ConsultCta from '../components/ConsultCta.astro';
import GuideCard from '../components/GuideCard.astro';
import Icon from '../components/Icon.astro';
import ProductTile from '../components/ProductTile.astro';
import RoutineSchedule from '../components/RoutineSchedule.astro';
import Layout from '../layouts/Layout.astro';
import { mainImage } from '../lib/catalog.ts';
import { getCatalog } from '../lib/catalog-cache.ts';
import { CatalogError } from '../lib/errors.ts';
import { resolveGuideProducts, sortGuides } from '../lib/guides.ts';
import { buildRoutines } from '../lib/routine.ts';
import { STORE } from '../lib/site.ts';
import type { Product } from '../lib/types.ts';

const FEATURED_COUNT = 5;
const HOME_GUIDES_COUNT = 4;

type IconName = ComponentProps<typeof Icon>['name'];

let products: Product[] = [];
let loadFailed = false;
try {
  products = (await getCatalog()).products;
} catch (error) {
  if (!(error instanceof CatalogError)) throw error;
  loadFailed = true;
  Astro.response.status = 503;
}

const routine = buildRoutines(products)[0];
const lead = products[0];
const leadImage = lead ? mainImage(lead) : null;
const featured = products.slice(0, FEATURED_COUNT);

const guides = sortGuides(await getCollection('guides'))
  .slice(0, HOME_GUIDES_COUNT)
  .map((guide) => ({ guide, cover: resolveGuideProducts(guide.data, products).cover }));
const [leadGuide, ...otherGuides] = guides;

// Anchos y proporciones alternados: la grilla no es simétrica a propósito
const TILE_PATTERN = [
  { span: 'lg:col-span-7', aspect: 'aspect-square' },
  { span: 'lg:col-span-5', aspect: 'aspect-[4/5]' },
  { span: 'lg:col-span-4', aspect: 'aspect-[4/5]' },
  { span: 'lg:col-span-4', aspect: 'aspect-square' },
  { span: 'lg:col-span-4', aspect: 'aspect-[4/5]' },
];

const pillars = [
  { icon: 'book-open', label: 'Aprender' },
  { icon: 'magnifier', label: 'Elegir' },
  { icon: 'leaf', label: 'Cuidarte' },
] satisfies { icon: IconName; label: string }[];

// Tres accesos de ancho distinto: ayudan a decidir por dónde empezar sin armar una fila de tarjetas iguales
const paths = [
  { icon: 'sparkle', title: 'Estoy empezando', text: 'Una guía para entender los pasos básicos del cuidado de la piel.', href: '/aprende/rutina-de-skincare-desde-cero', cta: 'Empezar por acá', span: 'lg:col-span-5', offset: '', tone: 'bg-blush/80', iconTone: 'bg-surface' },
  { icon: 'list-checks', title: 'Quiero mejorar mi rutina', text: 'Ordená los productos que ya usás e incorporá nuevos de forma adecuada.', href: '/rutinas', cta: 'Ver rutinas', span: 'lg:col-span-4', offset: 'lg:mt-10', tone: 'bg-surface', iconTone: 'bg-blush' },
  { icon: 'magnifier', title: 'Busco un producto específico', text: 'Entrá directo al catálogo si ya sabés qué necesitás.', href: '/productos', cta: 'Ver productos', span: 'lg:col-span-3', offset: 'lg:mt-20', tone: 'bg-surface', iconTone: 'bg-blush' },
] satisfies { icon: IconName; title: string; text: string; href: string; cta: string; span: string; offset: string; tone: string; iconTone: string }[];

const buyingSteps = [
  { title: 'Explorá', text: 'Mirá los productos y sus fichas educativas.' },
  { title: 'Agregá', text: 'Sumá al pedido los productos que te interesan.' },
  { title: 'Enviá', text: 'Mandá tu pedido por WhatsApp para coordinar la compra.' },
];
---

<Layout>
  <!-- 1. Hero -->
  <section class="mx-auto grid w-full max-w-[1280px] items-center gap-12 px-5 pb-16 pt-6 sm:px-8 lg:min-h-[min(88dvh,54rem)] lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6">
      <p class="reveal glass inline-flex items-center gap-3 rounded-full px-4 py-2 text-sm" style="--i:0">
        <span class="breathe" aria-hidden="true"></span>
        Tu piel, tu rutina
      </p>
      <h1 class="reveal mt-6 max-w-[17ch] text-[2.5rem] font-medium leading-[1.02] tracking-tighter sm:text-5xl lg:text-6xl" style="--i:1">
        Aprendé a cuidar tu piel. Encontrá tu rutina.
      </h1>
      <p class="reveal mt-6 max-w-[52ch] text-lg text-muted" style="--i:2">
        Descubrí para qué sirve cada producto, cómo incorporarlo a tu día a día y qué pasos seguir para cuidar tu piel con más confianza.
      </p>
      <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--i:3">
        <a href="/rutinas" class="btn btn-solid gap-2">Descubrir mi rutina<Icon name="arrow-up-right" class="size-[1.1rem]" /></a>
        <a href="/productos" class="btn btn-ghost">Ver productos</a>
      </div>
      <ul class="reveal mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm text-muted" style="--i:4">
        {pillars.map((pillar) => (
          <li class="flex items-center gap-2"><Icon name={pillar.icon} class="size-[1.15rem] text-rose" />{pillar.label}</li>
        ))}
      </ul>
    </div>

    <div class="reveal relative mx-auto w-full max-w-[34rem] pb-10 lg:col-span-6 lg:max-w-none lg:pl-10" style="--i:2">
      {
        leadImage && (
          <a href={`/productos/${lead.slug}`} class="tile float-slow block overflow-hidden" aria-label={`Ver ${lead.name}`}>
            <div class="shimmer aspect-[4/4.3] w-full">
              <img src={leadImage.url} alt={leadImage.alt} class="size-full object-cover" />
            </div>
          </a>
        )
      }
      <div class="glass float-slow absolute -bottom-2 left-0 w-[17.5rem] rounded-[2rem] p-5 [animation-delay:-3s] sm:-left-4">
        <p class="font-display text-base font-medium">Tu rutina en 3 pasos</p>
        <ol class="mt-3 grid gap-2">
          {['Limpiar', 'Tratar e hidratar', 'Proteger'].map((label, index) => (
            <li class="flex items-center gap-3 text-sm">
              <span class="grid size-6 place-items-center rounded-full bg-blush text-xs font-medium text-rose-deep">{index + 1}</span>
              <span>{label}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 2. Empezá por lo que necesitás -->
  <section class="mx-auto w-full max-w-[1280px] px-5 py-20 sm:px-8" aria-labelledby="empezar">
    <h2 id="empezar" class="text-3xl font-medium tracking-tighter sm:text-4xl">Empezá por lo que necesitás</h2>
    <div class="mt-10 grid items-start gap-5 lg:grid-cols-12">
      {paths.map((item, index) => (
        <a href={item.href} class:list={['tile reveal group block p-8 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 sm:p-10', item.span, item.offset, item.tone]} style={`--i:${index}`}>
          <span class:list={['grid size-12 place-items-center rounded-full text-rose-deep', item.iconTone]}><Icon name={item.icon} class="size-6" /></span>
          <h3 class="mt-8 text-2xl font-medium">{item.title}</h3>
          <p class="mt-2 text-muted">{item.text}</p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-rose-deep underline decoration-brand underline-offset-4 group-hover:decoration-current">
            {item.cta}<Icon name="arrow-right" class="size-4" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Aprendé con Camila -->
  {
    leadGuide && (
      <section class="mx-auto w-full max-w-[1280px] px-5 py-16 sm:px-8" aria-labelledby="aprende">
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <div>
            <h2 id="aprende" class="text-3xl font-medium tracking-tighter sm:text-4xl">Aprendé con Camila</h2>
            <p class="mt-3 max-w-[52ch] text-muted">Guías cortas para entender tu rutina antes de elegir qué comprar.</p>
          </div>
          <a href="/aprende" class="inline-flex min-h-10 items-center gap-1.5 text-rose-deep underline decoration-brand underline-offset-4 hover:decoration-current">
            Ver todas las guías<Icon name="arrow-up-right" class="size-4" />
          </a>
        </div>
        <div class="mt-10 grid gap-x-8 gap-y-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <GuideCard slug={leadGuide.guide.id} {...leadGuide.guide.data} cover={leadGuide.cover} size="large" />
          </div>
          <div class="grid content-start gap-8 lg:col-span-5">
            {otherGuides.map(({ guide, cover }, index) => (
              <GuideCard slug={guide.id} {...guide.data} cover={cover} index={index + 1} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 4. Productos destacados -->
  <section class="mx-auto w-full max-w-[1280px] px-5 py-20 sm:px-8" aria-labelledby="productos">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <h2 id="productos" class="text-3xl font-medium tracking-tighter sm:text-4xl">Productos destacados</h2>
      <a href="/productos" class="inline-flex min-h-10 items-center gap-1.5 text-rose-deep underline decoration-brand underline-offset-4 hover:decoration-current">
        Ver todos los productos<Icon name="arrow-up-right" class="size-4" />
      </a>
    </div>
    {
      loadFailed ? (
        <div class="tile mt-10 p-8">
          <p class="font-display text-xl font-medium">No pudimos cargar el catálogo.</p>
          <p class="mt-1 text-muted">Probá de nuevo en unos minutos.</p>
        </div>
      ) : featured.length === 0 ? (
        <div class="tile mt-10 p-8">
          <p class="font-display text-xl font-medium">Estamos cargando los productos.</p>
          <p class="mt-1 text-muted">Volvé a visitarnos muy pronto.</p>
        </div>
      ) : (
        <div class="mt-10 grid grid-cols-2 items-start gap-x-5 gap-y-14 lg:grid-cols-12">
          {featured.map((product, index) => {
            const pattern = TILE_PATTERN[index % TILE_PATTERN.length];
            return (
              <div class:list={[index === 0 ? 'col-span-2' : '', pattern.span]}>
                <ProductTile product={product} aspect={pattern.aspect} index={index} />
              </div>
            );
          })}
        </div>
      )
    }
  </section>

  <!-- 5. Tu rutina, paso a paso -->
  <section class="mx-auto w-full max-w-[1280px] px-5 py-20 sm:px-8" aria-labelledby="rutina">
    <div class="max-w-[52ch]">
      <h2 id="rutina" class="text-3xl font-medium tracking-tighter sm:text-4xl">Tu rutina, paso a paso</h2>
      <p class="mt-3 text-muted">Una forma simple de ordenar tu día y tu noche.</p>
    </div>
    <div class="mt-10">
      <RoutineSchedule />
    </div>
    <a href="/rutinas" class="btn btn-solid mt-10 gap-2">Descubrir productos para mi rutina<Icon name="arrow-right" class="size-4" /></a>
  </section>

  <!-- 6. Te ayudamos a elegir -->
  <section class="mx-auto w-full max-w-[1280px] px-5 py-12 sm:px-8">
    <ConsultCta />
  </section>

  <!-- 7. Cómo comprar -->
  <section id="como-comprar" class="mx-auto w-full max-w-[1280px] scroll-mt-28 px-5 py-20 sm:px-8" aria-labelledby="comprar">
    <h2 id="comprar" class="text-3xl font-medium tracking-tighter sm:text-4xl">Cómo comprar</h2>
    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {buyingSteps.map((step, index) => (
        <li class="reveal relative" style={`--i:${index}`}>
          <span class="grid size-11 place-items-center rounded-full bg-rose font-display text-lg font-medium text-white">{index + 1}</span>
          <h3 class="mt-5 text-2xl font-medium">{step.title}</h3>
          <p class="mt-2 max-w-[34ch] text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
    <ul class="mt-12 flex flex-wrap gap-3">
      <li class="chip !whitespace-normal !px-4 !py-2 text-[0.95rem]"><Icon name="map-pin" class="size-[1.1rem] text-rose" />Vendemos en {STORE.city}</li>
      <li class="chip !whitespace-normal !px-4 !py-2 text-[0.95rem]"><Icon name="truck" class="size-[1.1rem] text-rose" />Retiro o envío</li>
      <li class="chip !whitespace-normal !px-4 !py-2 text-[0.95rem]"><Icon name="hand-coins" class="size-[1.1rem] text-rose" />Efectivo o transferencia</li>
    </ul>
  </section>

  <!-- 8. Cierre -->
  <section class="mx-auto w-full max-w-[1280px] px-5 pb-8 pt-12 sm:px-8" aria-labelledby="cierre">
    <div class="tile reveal grid gap-8 p-8 sm:p-14 lg:grid-cols-[1.5fr_1fr] lg:items-end">
      <div>
        <h2 id="cierre" class="max-w-[20ch] text-3xl font-medium leading-[1.05] tracking-tighter sm:text-5xl">Cuidarte empieza por entender qué necesita tu piel.</h2>
        <p class="mt-5 max-w-[48ch] text-lg text-muted">Explorá, aprendé y encontrá los productos que mejor acompañen tu rutina.</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a href="/productos" class="btn btn-solid">Ver productos</a>
        <a href="/aprende" class="btn btn-ghost">Aprender con Camila</a>
      </div>
    </div>
  </section>
</Layout>

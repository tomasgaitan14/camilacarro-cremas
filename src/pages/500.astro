---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Algo salió mal">
  <div class="mx-auto w-full max-w-[1280px] px-5 py-20 sm:px-8">
    <div class="tile reveal max-w-2xl p-8 sm:p-12">
      <h1 class="text-3xl font-medium tracking-tighter sm:text-4xl">Algo salió mal de nuestro lado.</h1>
      <p class="mt-3 max-w-[48ch] text-muted">No pudimos mostrar esta página. Probá de nuevo en unos minutos.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-solid">Ir al inicio</a>
        <a href="/productos" class="btn btn-ghost">Ver los productos</a>
      </div>
    </div>
  </div>
</Layout>

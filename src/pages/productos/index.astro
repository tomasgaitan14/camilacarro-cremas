---
import Icon from '../../components/Icon.astro';
import ProductTile from '../../components/ProductTile.astro';
import Layout from '../../layouts/Layout.astro';
import { filterProducts } from '../../lib/catalog-filter.ts';
import { getCatalog } from '../../lib/catalog-cache.ts';
import { CatalogError } from '../../lib/errors.ts';
import { catalogHref, parseCatalogFilters } from '../../lib/filters.ts';
import type { Brand, Category, Product } from '../../lib/types.ts';

const BASE = '/productos';
// proporciones que se alternan en la grilla
const SHAPES = [
  { aspect: 'aspect-[4/5]' },
  { aspect: 'aspect-square' },
  { aspect: 'aspect-[4/5]' },
];

const filters = parseCatalogFilters(Astro.url.searchParams);
const hasFilters = Boolean(filters.brandSlug || filters.categorySlug || filters.search);

let products: Product[] = [];
let brands: Brand[] = [];
let categories: Category[] = [];
let loadFailed = false;
try {
  const catalog = await getCatalog();
  products = filterProducts(catalog.products, filters);
  brands = catalog.brands;
  categories = catalog.categories;
} catch (error) {
  if (!(error instanceof CatalogError)) throw error;
  loadFailed = true;
  Astro.response.status = 503;
}

const countLabel = products.length === 1 ? '1 producto' : `${products.length} productos`;
---

<Layout title="Productos" description="Todas las cremas y productos de cuidado de la piel de Camila Carro, con su modo de uso y beneficios.">
  <div class="mx-auto w-full max-w-[1280px] px-5 pb-8 pt-6 sm:px-8">
    <h1 class="reveal text-4xl font-medium tracking-tighter sm:text-5xl">Productos</h1>

    <div class="tile reveal mt-8 grid gap-6 p-6 sm:p-8 lg:grid-cols-[18rem_1fr]" style="--i:1">
      <form method="get" action={BASE} role="search" class="flex min-w-0 gap-2">
        {filters.brandSlug && <input type="hidden" name="marca" value={filters.brandSlug} />}
        {filters.categorySlug && <input type="hidden" name="categoria" value={filters.categorySlug} />}
        <label class="sr-only" for="buscar">Buscar por nombre</label>
        <input id="buscar" name="q" type="search" value={filters.search ?? ''} placeholder="Buscar por nombre" maxlength="60" class="field w-full min-w-0 flex-1" />
        <button type="submit" class="btn btn-solid size-12 shrink-0 px-0" aria-label="Buscar"><Icon name="magnifier" /></button>
      </form>

      <div class="grid gap-4">
        {
          brands.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              <span class="mr-2 w-16 text-sm text-muted">Marca</span>
              <a href={catalogHref(BASE, filters, { brandSlug: undefined })} class="chip" aria-current={!filters.brandSlug ? 'true' : undefined}>Todas</a>
              {brands.map((brand) => (
                <a href={catalogHref(BASE, filters, { brandSlug: brand.slug })} class="chip" aria-current={filters.brandSlug === brand.slug ? 'true' : undefined}>{brand.name}</a>
              ))}
            </div>
          )
        }
        {
          categories.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              <span class="mr-2 w-16 text-sm text-muted">Tipo</span>
              <a href={catalogHref(BASE, filters, { categorySlug: undefined })} class="chip" aria-current={!filters.categorySlug ? 'true' : undefined}>Todos</a>
              {categories.map((category) => (
                <a href={catalogHref(BASE, filters, { categorySlug: category.slug })} class="chip" aria-current={filters.categorySlug === category.slug ? 'true' : undefined}>{category.name}</a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <section aria-labelledby="resultados" class="mt-10">
      <h2 id="resultados" class="sr-only">Resultados</h2>
      {
        loadFailed ? (
          <div class="tile p-8">
            <p class="font-display text-xl font-medium">No pudimos cargar el catálogo.</p>
            <p class="mt-1 text-muted">Probá de nuevo en unos minutos.</p>
          </div>
        ) : products.length === 0 ? (
          <div class="tile p-8">
            <p class="font-display text-xl font-medium">{hasFilters ? 'No encontramos productos con esos filtros.' : 'Todavía no hay productos cargados.'}</p>
            {hasFilters && <a href={BASE} class="btn btn-ghost mt-5">Quitar los filtros</a>}
          </div>
        ) : (
          <>
            <p class="text-muted" aria-live="polite">{countLabel}</p>
            <div class="mt-6 grid grid-cols-2 items-start gap-x-5 gap-y-12 lg:grid-cols-3">
              {products.map((product, index) => (
                <div class="lg:[&:nth-child(3n+2)]:mt-14">
                  <ProductTile product={product} aspect={SHAPES[index % SHAPES.length].aspect} index={index} />
                </div>
              ))}
            </div>
          </>
        )
      }
    </section>
  </div>
</Layout>

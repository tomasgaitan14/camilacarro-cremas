---
import Icon from '../../components/Icon.astro';
import ProductTile from '../../components/ProductTile.astro';
import RoutineRail from '../../components/RoutineRail.astro';
import Layout from '../../layouts/Layout.astro';
import { getCatalog } from '../../lib/catalog-cache.ts';
import { findProduct } from '../../lib/catalog-filter.ts';
import { MAX_QTY_PER_ITEM } from '../../lib/constants.ts';
import { CatalogError } from '../../lib/errors.ts';
import { formatArs } from '../../lib/money.ts';
import { buildRoutines } from '../../lib/routine.ts';
import type { Product } from '../../lib/types.ts';

const RELATED_COUNT = 3;
const LOW_STOCK_THRESHOLD = 3;

const slug = Astro.params.slug ?? '';
let product: Product | null = null;
let all: Product[] = [];
let loadFailed = false;
try {
  all = (await getCatalog()).products;
  product = findProduct(all, slug);
} catch (error) {
  if (!(error instanceof CatalogError)) throw error;
  loadFailed = true;
  Astro.response.status = 503;
}
if (!product && !loadFailed) Astro.response.status = 404;

const routine = product?.line ? buildRoutines(all).find((candidate) => candidate.line.id === product?.line?.id) : undefined;
const currentStep = routine?.steps.find((step) => step.products.some((item) => item.id === product?.id));
const related = product
  ? all
      .filter((item) => item.id !== product?.id)
      .sort((a, b) => Number(b.category.id === product?.category.id) - Number(a.category.id === product?.category.id))
      .slice(0, RELATED_COUNT)
  : [];
const maxQty = product ? Math.min(product.stock, MAX_QTY_PER_ITEM) : 0;
const extraImages = product ? product.images.filter((image) => image.id !== product?.images[0]?.id) : [];
---

<Layout title={product?.name ?? 'Producto'} description={product?.summary || undefined}>
  {
    !product ? (
      <div class="mx-auto w-full max-w-[1280px] px-5 py-20 sm:px-8">
        <div class="tile max-w-2xl p-8 sm:p-12">
          <h1 class="text-3xl font-medium tracking-tighter sm:text-4xl">
            {loadFailed ? 'No pudimos cargar el producto.' : 'No encontramos ese producto.'}
          </h1>
          <p class="mt-3 text-muted">
            {loadFailed ? 'Probá de nuevo en unos minutos.' : 'Puede que ya no esté disponible o que el link tenga un error.'}
          </p>
          <a href="/productos" class="btn btn-solid mt-7">Ver todos los productos</a>
        </div>
      </div>
    ) : (
      <div class="mx-auto w-full max-w-[1280px] px-5 pb-8 pt-4 sm:px-8">
        <a href="/productos" class="inline-flex min-h-10 items-center gap-2 text-sm text-muted hover:text-rose-deep">Volver a productos</a>

        <div class="mt-6 grid gap-8 lg:grid-cols-12 lg:gap-10">
          <div class="reveal lg:col-span-7">
            <div class="tile overflow-hidden">
              <div class="shimmer aspect-[4/4.6] w-full">
                {product.images[0] && <img src={product.images[0].url} alt={product.images[0].alt} width="900" height="1035" class="size-full object-cover" />}
              </div>
            </div>
            {extraImages.length > 0 && (
              <ul class="mt-4 grid grid-cols-4 gap-3">
                {extraImages.map((image) => (
                  <li class="tile aspect-square overflow-hidden !rounded-3xl">
                    <img src={image.url} alt={image.alt} width="240" height="240" loading="lazy" class="size-full object-cover" />
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="reveal lg:sticky lg:top-28 lg:col-span-5 lg:self-start" style="--i:1">
            <div class="flex flex-wrap gap-2">
              <a href={`/productos?marca=${product.brand.slug}`} class="chip">{product.brand.name}</a>
              <a href={`/productos?categoria=${product.category.slug}`} class="chip">{product.category.name}</a>
            </div>
            <h1 class="mt-5 text-4xl font-medium leading-[1.04] tracking-tighter sm:text-5xl">{product.name}</h1>
            {product.summary && <p class="mt-4 max-w-[48ch] text-lg text-muted">{product.summary}</p>}

            <p class="mt-7 flex items-baseline gap-3">
              <span class="font-display text-4xl font-medium tabular-nums tracking-tight">{formatArs(product.priceArs)}</span>
              {product.volume && <span class="text-muted">{product.volume}</span>}
            </p>

            {product.stock === 0 ? (
              <div class="mt-7">
                <button type="button" class="btn w-full" disabled>Sin stock por ahora</button>
                <p class="mt-3 text-sm text-muted">Por ahora no hay unidades disponibles.</p>
              </div>
            ) : (
              <div class="mt-7">
                <div class="flex items-center gap-3">
                  <label class="sr-only" for="cantidad">Cantidad</label>
                  <input id="cantidad" type="number" inputmode="numeric" min="1" max={maxQty} value="1" data-qty-for={product.id} class="field w-24 text-center tabular-nums" />
                  <button type="button" data-add-to-cart data-product-id={product.id} class="btn btn-solid flex-1">
                    <span class="when-idle"><span class="inline-flex items-center gap-2"><Icon name="plus" class="size-[1.1rem]" />Agregar al pedido</span></span>
                    <span class="when-added" aria-hidden="true"><Icon name="check" class="size-[1.1rem]" />Agregado al pedido</span>
                  </button>
                </div>
                {product.stock <= LOW_STOCK_THRESHOLD && (
                  <p class="mt-3 flex items-center gap-2 text-sm text-rose-deep">
                    <span class="breathe" aria-hidden="true" />
                    {product.stock === 1 ? 'Queda 1 unidad.' : `Quedan ${product.stock} unidades.`}
                  </p>
                )}
              </div>
            )}
          </div>
        </div>

        <div class="mt-14 grid gap-5 lg:grid-cols-12">
          {product.benefits.length > 0 && (
            <section class="tile reveal p-8 sm:p-10 lg:col-span-5" style="--i:2" aria-labelledby="beneficios">
              <h2 id="beneficios" class="text-2xl font-medium">Qué hace por tu piel</h2>
              <ul class="mt-6 grid gap-4">
                {product.benefits.map((benefit) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-blush text-rose-deep"><Icon name="check" class="size-3.5" /></span>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {product.usageSteps.length > 0 && (
            <section class="tile reveal p-8 sm:p-10 lg:col-span-7" style="--i:3" aria-labelledby="uso">
              <h2 id="uso" class="text-2xl font-medium">Cómo se usa</h2>
              <ol class="mt-6 grid gap-2">
                {product.usageSteps.map((step, index) => (
                  <li class="step-cycle flex items-start gap-4 rounded-2xl p-3" style={`--i:${index};--n:${product.usageSteps.length}`}>
                    <span class="grid size-8 shrink-0 place-items-center rounded-full bg-rose font-display text-sm font-medium text-white">{index + 1}</span>
                    <span class="pt-1">{step}</span>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {product.keyIngredients && (
            <section class="tile reveal p-8 sm:p-10 lg:col-span-7" style="--i:4" aria-labelledby="ingredientes">
              <h2 id="ingredientes" class="text-2xl font-medium">Ingredientes principales</h2>
              <p class="mt-4 max-w-[56ch] text-muted">{product.keyIngredients}</p>
            </section>
          )}

          {product.skinTypes.length > 0 && (
            <section class="tile reveal p-8 sm:p-10 lg:col-span-5" style="--i:5" aria-labelledby="piel">
              <h2 id="piel" class="text-2xl font-medium">Para qué piel</h2>
              <ul class="mt-5 flex flex-wrap gap-2">
                {product.skinTypes.map((type) => (
                  <li class="chip">{type}</li>
                ))}
              </ul>
            </section>
          )}

          {product.warnings && (
            <section class="reveal flex items-start gap-4 rounded-[2rem] bg-blush/70 p-6 sm:p-8 lg:col-span-12" style="--i:6" aria-labelledby="precauciones">
              <Icon name="warning" class="mt-1 size-6 text-rose-deep" />
              <div>
                <h2 id="precauciones" class="text-lg font-medium">Precauciones</h2>
                <p class="mt-1 max-w-[64ch] text-muted">{product.warnings}</p>
              </div>
            </section>
          )}
        </div>

        {routine && currentStep ? (
          <section class="mt-20" aria-labelledby="rutina">
            <h2 id="rutina" class="text-3xl font-medium tracking-tighter">Dónde va en tu rutina</h2>
            <p class="mt-3 max-w-[52ch] text-muted">
              Es el paso {currentStep.step} de la rutina {routine.line.name}: {currentStep.label.toLowerCase()}.
            </p>
            <div class="mt-8">
              <RoutineRail routine={routine} currentProductId={product.id} />
            </div>
          </section>
        ) : (
          related.length > 0 && (
            <section class="mt-20" aria-labelledby="mas">
              <h2 id="mas" class="text-3xl font-medium tracking-tighter">Otros productos</h2>
              <div class="mt-8 grid grid-cols-2 items-start gap-x-5 gap-y-12 md:grid-cols-3">
                {related.map((item, index) => (
                  <div class="md:[&:nth-child(2)]:mt-12">
                    <ProductTile product={item} index={index} aspect={index === 1 ? 'aspect-square' : 'aspect-[4/5]'} />
                  </div>
                ))}
              </div>
            </section>
          )
        )}
      </div>
    )
  }
</Layout>

---
import { getEntry, render } from 'astro:content';
import ConsultCta from '../../components/ConsultCta.astro';
import Icon from '../../components/Icon.astro';
import ProductTile from '../../components/ProductTile.astro';
import Layout from '../../layouts/Layout.astro';
import { mainImage } from '../../lib/catalog.ts';
import { getCatalog } from '../../lib/catalog-cache.ts';
import { CatalogError } from '../../lib/errors.ts';
import { resolveGuideProducts } from '../../lib/guides.ts';
import type { Product } from '../../lib/types.ts';

const entry = await getEntry('guides', Astro.params.slug ?? '');
if (!entry) Astro.response.status = 404;

let products: Product[] = [];
try {
  products = (await getCatalog()).products;
} catch (error) {
  if (!(error instanceof CatalogError)) throw error;
}

const { Content } = entry ? await render(entry) : { Content: null };
const { cover, related } = entry ? resolveGuideProducts(entry.data, products) : { cover: null, related: [] };
const coverImage = cover ? mainImage(cover) : null;
---

<Layout title={entry?.data.title ?? 'Guía no encontrada'} description={entry?.data.summary}>
  {
    !entry || !Content ? (
      <div class="mx-auto w-full max-w-[1280px] px-5 py-20 sm:px-8">
        <div class="tile max-w-2xl p-8 sm:p-12">
          <h1 class="text-3xl font-medium tracking-tighter sm:text-4xl">No encontramos esa guía.</h1>
          <p class="mt-3 text-muted">Puede que el link tenga un error. Mirá las guías disponibles.</p>
          <a href="/aprende" class="btn btn-solid mt-7">Ver las guías</a>
        </div>
      </div>
    ) : (
      <article class="mx-auto w-full max-w-[1280px] px-5 pb-8 pt-4 sm:px-8">
        <a href="/aprende" class="inline-flex min-h-10 items-center gap-2 text-sm text-muted hover:text-rose-deep">Volver a Aprendé</a>

        <div class="mt-6 grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="reveal lg:col-span-7">
            <p class="flex flex-wrap items-center gap-2 text-sm text-muted">
              <span>{entry.data.readingMinutes} min de lectura</span>
              {entry.data.status === 'borrador' && <span class="chip !py-0.5 text-xs">Borrador</span>}
            </p>
            <h1 class="mt-3 text-4xl font-medium leading-[1.04] tracking-tighter sm:text-5xl">{entry.data.title}</h1>
            <p class="mt-4 max-w-[52ch] text-lg text-muted">{entry.data.summary}</p>
            {entry.data.status === 'borrador' && (
              <p class="mt-6 flex items-start gap-3 rounded-2xl bg-blush/70 px-5 py-4 text-sm text-rose-deep">
                <Icon name="warning" class="mt-0.5 size-5" />
                <span>Borrador para revisar con Camila. Es información general y orientativa: todavía no está validada.</span>
              </p>
            )}
            <div class="prose-guide mt-10">
              <Content />
            </div>
          </div>

          <aside class="reveal lg:sticky lg:top-28 lg:col-span-5 lg:self-start" style="--i:1" aria-label="Productos de esta guía">
            {coverImage && (
              <div class="tile overflow-hidden">
                <div class="shimmer aspect-[4/3] w-full">
                  <img src={coverImage.url} alt={coverImage.alt} width="800" height="600" class="size-full object-cover" />
                </div>
              </div>
            )}
            <a href="/rutinas" class="btn btn-ghost mt-5 w-full gap-2">Ver rutinas completas<Icon name="arrow-right" class="size-4" /></a>
          </aside>
        </div>

        {related.length > 0 && (
          <section class="mt-20" aria-labelledby="productos-guia">
            <h2 id="productos-guia" class="text-3xl font-medium tracking-tighter">Productos de esta guía</h2>
            <p class="mt-3 max-w-[52ch] text-muted">Cada ficha explica para qué sirve, cómo se usa y en qué paso de la rutina va.</p>
            <div class="mt-8 grid grid-cols-2 items-start gap-x-5 gap-y-12 md:grid-cols-3">
              {related.map((product, index) => (
                <div class="md:[&:nth-child(2)]:mt-12">
                  <ProductTile product={product} index={index} aspect={index === 1 ? 'aspect-square' : 'aspect-[4/5]'} />
                </div>
              ))}
            </div>
          </section>
        )}

        <div class="mt-24">
          <ConsultCta />
        </div>
      </article>
    )
  }
</Layout>

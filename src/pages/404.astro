---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="Página no encontrada">
  <div class="mx-auto w-full max-w-[1280px] px-5 py-20 sm:px-8">
    <div class="tile reveal max-w-2xl p-8 sm:p-12">
      <h1 class="text-3xl font-medium tracking-tighter sm:text-4xl">No encontramos esa página.</h1>
      <p class="mt-3 max-w-[48ch] text-muted">Puede que el link tenga un error o que la página ya no exista. Mirá los productos o volvé al inicio.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/productos" class="btn btn-solid">Ver los productos</a>
        <a href="/" class="btn btn-ghost">Ir al inicio</a>
      </div>
    </div>
  </div>
</Layout>

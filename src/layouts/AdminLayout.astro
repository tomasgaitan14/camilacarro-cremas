---
import { ADMIN_PATHS } from '../lib/admin-auth.ts';
import { STORE } from '../lib/site.ts';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const adminUser = Astro.locals.adminUser;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Panel de {STORE.name}</title>
    <link rel="icon" type="image/webp" href={STORE.logoUrl} />
  </head>
  <body>
    <header class="mx-auto flex w-full max-w-[1100px] items-center justify-between gap-4 px-5 py-5 sm:px-8">
      <a href={ADMIN_PATHS.HOME} class="flex min-h-10 items-center gap-3">
        <img src={STORE.logoUrl} alt="" width="40" height="40" class="size-10 rounded-full" />
        <span class="font-display text-lg font-medium tracking-tight">Panel de {STORE.name}</span>
      </a>
      {
        adminUser && (
          <form method="post" action={ADMIN_PATHS.LOGOUT} class="flex items-center gap-3">
            <span class="hidden text-sm text-muted sm:inline">{adminUser.email}</span>
            <button type="submit" class="btn btn-ghost btn-sm">Salir</button>
          </form>
        )
      }
    </header>
    <main class="mx-auto w-full max-w-[1100px] px-5 pb-16 sm:px-8">
      <slot />
    </main>
  </body>
</html>

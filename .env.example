# Supabase (local: `npm run db:start` y `npx supabase status -o env`)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Solo scripts del servidor (seed). Nunca con prefijo PUBLIC_: terminaría en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp de la tienda: solo dígitos con código de país (ej. 549 + característica + número)
PUBLIC_WHATSAPP_NUMBER=

# Usuario admin del panel (solo para el seed local; en producción se crea aparte)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

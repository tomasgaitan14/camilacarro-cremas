# Credencial del login con Google (Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de OAuth).
# Copiar este archivo a supabase/.env y completar. Ese archivo está ignorado por git.
# URI de redirección autorizada en Google (local): http://127.0.0.1:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
